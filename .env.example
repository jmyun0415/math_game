# ==========================================================
# Numbers API & Math Game 환경 변수 설정 템플릿 (.env.example)
# ==========================================================
# 실제 사용 시 이 파일을 복사하여 '.env' 파일로 이름을 변경하고 값을 설정하세요.
#
# Numbers API(numbersapi.com)는 기본적으로 인증 키 없이 무료로 동작합니다.
# 유료 API 프록시 또는 인증이 필요한 커스텀 엔드포인트를 사용할 경우 아래 설정을 입력합니다.

# 1. API 엔드포인트 URL (기본값: http://numbersapi.com)
NUMBERS_API_BASE_URL=http://numbersapi.com

# 2. API Key (인증이 필요한 경우 입력, 기본 빈 문자열)
# 예: NUMBERS_API_KEY=your_api_key_here
NUMBERS_API_KEY=

# 3. 네트워크 요청 제한 시간 (초 단위, 기본값: 3.0)
API_TIMEOUT_SECONDS=3.0
